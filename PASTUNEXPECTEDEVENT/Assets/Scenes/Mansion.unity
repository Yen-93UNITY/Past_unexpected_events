  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c316e1fec61059a4f80c26df5b3b46db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1967217194}
  dialogueText: {fileID: 1967217193}
  nameText: {fileID: 1967217192}
  leftImage: {fileID: 1967217191}
  rightImage: {fileID: 1967217190}
  leftCanvas: {fileID: 1967217189}
  rightCanvas: {fileID: 1967217188}
  leftRect: {fileID: 1967217187}
  rightRect: {fileID: 1967217186}
  choicePanel: {fileID: 1967217185}
  choiceButtons:
  - {fileID: 1967217184}
  - {fileID: 1967217183}
  - {fileID: 1967217182}
  - {fileID: 1967217181}
  - {fileID: 1967217180}
  choiceButtonComponents: []
  interactButton: {fileID: 787834228}
  interactPrompt: {fileID: 0}
  talkingAudio: {fileID: 0}
  InteractSound: {fileID: 0}
  player: {fileID: 1451274852}
  dialogueStates:
  - stateName: 
    dialogueElements:
    - rawText: '[NameSilri][LImg66o2]Wait..'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameSilri][LImg66o1][LEaseYQ]Pardon me, Young Master, but where
        might you be headed?'
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: That is none of your concern.
        jumpToStateIndex: 0
        jumpToElementIndex: 3
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: Nowhere in particular. Just taking a turn about the grounds.
        jumpToStateIndex: 0
        jumpToElementIndex: 3
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: (ignore)
        jumpToStateIndex: 0
        jumpToElementIndex: 3
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: I am looking for Ming. Have you seen her?
        jumpToStateIndex: 0
        jumpToElementIndex: 2
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: STAB
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: HasKnife
        requiredFlagValue: 1
    - rawText: '[NameSilri][LImg66o2][LEaseYQ]Very well, sir. I shall not disturb
        you further,i will have your bed turned down shortly.'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: BKnowMing
      isChoicePoint: 0
      choices: []
    - rawText: '[NameSilri][LImg66o4][LEaseYQ]...'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: (He Head back to mansion)
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameSilri][LImg66o3][LEaseShake]...!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[LImg66o3][RT](You stab his waist)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[LImg66o5][RT](And he quickly take away your knife before you continue)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameSilri][LImg66o4][LEaseYQ]Young master, you shouldn''t do that'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameSilri][LImg66o4][LEaseYQ]That''s not something a nobleman would
        do.'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: ...
        jumpToStateIndex: 1
        jumpToElementIndex: 5
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: Stab him again*
        jumpToStateIndex: 2
        jumpToElementIndex: 0
        requiredFlag: HasScissors
        requiredFlagValue: 1
    - rawText: '[NameSilri][LImg66o4][LYQ]Well, i will have your bed turned down
        shortly'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: KeepKnife
      isChoicePoint: 0
      choices: []
    - rawText: '[LEaseYQ][RT](He head back to the mansion.)'
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: BKnowKill
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameSilri][LImg66o3][LEaseShake]..!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[LImg66o3][LEaseShake][RT](He lay down on the ground,maybe he have
        died..)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: Stab*
        jumpToStateIndex: 2
        jumpToElementIndex: 2
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: ...
        jumpToStateIndex: 2
        jumpToElementIndex: 3
        requiredFlag: 
        requiredFlagValue: 0
    - rawText: '[LImg66o3][LEaseShake][RT][##FF0000]You Stab his head'
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices:
      - optionText: Stab*
        jumpToStateIndex: 3
        jumpToElementIndex: 1
        requiredFlag: 
        requiredFlagValue: 0
    - rawText: '[##FF0000]You got your knife back'
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: BDied
      isChoicePoint: 0
      choices: []
  triggerOnce: 0
  playerInRange: 0
  isTalking: 0
