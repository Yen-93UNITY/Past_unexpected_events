      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameServent]Didn''t you arrange to meet Ming today?'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: Oh ya...
        jumpToStateIndex: 0
        jumpToElementIndex: 2
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: Stab*
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: HasKnife
        requiredFlagValue: 1
    - rawText: '[NameServent]Good Luck then! :D imma just hang out afk here a bit'
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: ServantTalk
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameServent]!!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
