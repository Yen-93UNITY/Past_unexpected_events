  dialogueStates:
  - stateName: 0
    dialogueElements:
    - rawText: '[NameMing][LImg32o1]Oh- you''re here!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameMing][LImg32o1][LEaseYQ]Never thought of you''re going to wake
        up that early '
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: Becuz MrSilri wake me up :D
        jumpToStateIndex: 0
        jumpToElementIndex: 2
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: Btw im starving rn
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: '-'
        requiredFlagValue: 1
      - optionText: Stab
        jumpToStateIndex: 3
        jumpToElementIndex: 0
        requiredFlag: HasKnife
        requiredFlagValue: 1
    - rawText: '[NameMing][LImg32o1][LEaseYQ]:D btw what do you going to do now?'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: We should buy something!
