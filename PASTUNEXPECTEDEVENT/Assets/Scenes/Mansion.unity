        jumpToElementIndex: 0
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: We should eat something!
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: 
        requiredFlagValue: 0
  - stateName: 1
    dialogueElements:
    - rawText: '[NameMing][LImg32o1][LEaseYQ]:D Sure! let''s go buy something around
        here! Like the store behind me!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameMing][LImg32o1][LEaseYQ]:) There''s coffe shop,bread shop..and
