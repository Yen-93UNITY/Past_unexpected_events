    - rawText: :D Sure! let's go buy something around here! I'll follow you
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: 32ishere
      isChoicePoint: 0
      choices: []
  - stateName: 3
    dialogueElements:
    - rawText: '[NameMing]...?'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameMing]Why do you....'
