  dialogueStates:
  - stateName: 
    dialogueElements:
    - rawText: (A Man staying behind the tree)
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: He's crying over there-
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: ...?
        jumpToStateIndex: 0
        jumpToElementIndex: 2
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: Stab
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: HasKnife
        requiredFlagValue: 1
      - optionText: GiveTheWine
        jumpToStateIndex: 2
        jumpToElementIndex: 0
        requiredFlag: HasWine
        requiredFlagValue: 1
    - rawText: you ignore it
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameNPC].....?'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: You Stab him.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices:
      - optionText: Stab
        jumpToStateIndex: 1
        jumpToElementIndex: 2
        requiredFlag: 
        requiredFlagValue: 0
    - rawText: He lay on th ground, slowly
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices:
      - optionText: Stab
        jumpToStateIndex: 1
        jumpToElementIndex: 3
        requiredFlag: 
        requiredFlagValue: 0
    - rawText: ...
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: NPC2Died
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: Hey!
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameNPC].....?'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: Have a wine.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameNPC]Thanks..'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: (He go away...)
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: HelpSadNPC
      isChoicePoint: 0
      choices: []
  triggerOnce: 0
  playerInRange: 0
  isTalking: 0
