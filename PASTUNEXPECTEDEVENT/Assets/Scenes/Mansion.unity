  dialogueStates:
  - stateName: 
    dialogueElements:
    - rawText: '[NameNPC]Fresh morning to you, sir! The oven''s just singing.'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
