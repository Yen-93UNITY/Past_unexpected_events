      - optionText: Two Milk Bread, please.-x
        jumpToStateIndex: 0
        jumpToElementIndex: 3
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: What would you like, Ming?
        jumpToStateIndex: 0
        jumpToElementIndex: 2
        requiredFlag: 32IsTogether
        requiredFlagValue: 1
      - optionText: Stab
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: HasKnife
        requiredFlagValue: 1
    - rawText: '[NameMing]Oh then I''ll choose...two currant bun pls :D'
