  dialogueStates:
  - stateName: 
    dialogueElements:
    - rawText: '[NameNPC1]Hey do you know that guy yesterday we saw?'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameNPC2]Yup! look creepy,he just keep following that girl!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameNPC2]Yup-'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: There's nothing to see here, its just some NPC talking
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: Ignore
        jumpToStateIndex: 0
        jumpToElementIndex: 4
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: Stab
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: HasKnife
        requiredFlagValue: 1
    - rawText: You walk pass by them
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices:
      - optionText: Ignore
        jumpToStateIndex: 0
        jumpToElementIndex: 0
        requiredFlag: 
        requiredFlagValue: 0
      - optionText: Stab
        jumpToStateIndex: 1
        jumpToElementIndex: 0
        requiredFlag: HasKnife
        requiredFlagValue: 1
  - stateName: 
    dialogueElements:
    - rawText: '[NameNPC1] ?!!!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: '[NameNPC2] HEY YOU!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices: []
    - rawText: '[NameNPC2] Why do you do this?!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: Stab him
        jumpToStateIndex: 1
        jumpToElementIndex: 3
        requiredFlag: 
        requiredFlagValue: 0
    - rawText: '[NameNPC2]!'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 1
      choices:
      - optionText: Continue Stab him
        jumpToStateIndex: 1
        jumpToElementIndex: 4
        requiredFlag: 
        requiredFlagValue: 0
    - rawText: They both lay on the ground
      destroyNPCWhenFinished: 1
      hideNPCWhenFinished: 0
      customEventName: NPC1Died
      isChoicePoint: 0
      choices: []
  triggerOnce: 0
  playerInRange: 0
  isTalking: 0
