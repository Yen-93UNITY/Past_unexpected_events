  dialogueStates:
  - stateName: 
    dialogueElements:
    - rawText: A bread on the floor.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: What..?
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: You want this??
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: Hey..
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: Its discusting...
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameYou](but it look normal)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: BUT IT DROP AT THE FLOOR FOR 3 SECOND.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameYou](but...im starving...)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: THEN BUY A BREAD.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameYou](but...im broke..)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: THEN FIND YOUR PAPA.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameYou](but...Dad is not avalible..)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: THEN FIND YOUR MAMA
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameYou](but...mom is not on this world...)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: oh.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: THEN DONT EAT THIS BREAD
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: '[NameYou](but..)'
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: YOU HAVE YOUR MONEY IN YOUR ROOM OR NOT STEALS YOUR PAPA MONEY.
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  - stateName: 
    dialogueElements:
    - rawText: :(
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
    - rawText: (Sadly you can't eat this bread.)
      destroyNPCWhenFinished: 0
      hideNPCWhenFinished: 0
      customEventName: 
      isChoicePoint: 0
      choices: []
  triggerOnce: 0
  playerInRange: 0
  isTalking: 0
